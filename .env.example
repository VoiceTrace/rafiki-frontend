# Generate with: npx auth secret
AUTH_SECRET=

# Rafiqi API origin only; do not include a trailing slash.
# The production deployment must set this to the production API URL.
# Local Rafiqi API default: http://localhost:8000
API_URL=http://localhost:8000

# Optional legacy/generic auth adapter. API_URL takes precedence when both exist.
# AUTH_API_URL=http://localhost:8080

# Development only. When neither API_URL nor AUTH_API_URL is set, mock auth is enabled by default.
# Set this to false to exercise the unavailable-backend state locally.
AUTH_USE_MOCK_BACKEND=true

